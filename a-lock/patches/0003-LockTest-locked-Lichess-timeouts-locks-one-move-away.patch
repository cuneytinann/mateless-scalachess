 1 file changed, 37 insertions(+)
 create mode 100644 test-kit/src/test/scala/LockTest.scala

diff --git a/test-kit/src/test/scala/LockTest.scala b/test-kit/src/test/scala/LockTest.scala
new file mode 100644
index 0000000..3a23987
--- /dev/null
+++ b/test-kit/src/test/scala/LockTest.scala
@@ -0,0 +1,37 @@
+package chess
+
+import chess.format.FullFen
+import chess.mateless.Lock
+import chess.variant.Standard
+
+class LockTest extends ChessTest:
+
+  // Lichess timeouts scored as wins: the side to move ran out of time, though pawns, kings and
+  // bishops locked its opponent out of any mate.
+  List(
+    "8/8/4k3/3p2p1/1p1P1pP1/1P3P2/8/3K4 b - - 47 92",
+    "3k4/8/3p4/2pP1p1p/p1P2PpP/P2K2P1/8/8 b - - 4 56",
+    "8/8/4k3/p2p2p1/P2P2P1/2K5/8/8 w - - 51 75"
+  ).foreach: fen =>
+    test(s"locked: $fen"):
+      val position = fenToGame(FullFen(fen), Standard).position
+      assert(Lock.cannotBeMated(position, position.color))
+      assert(position.opponentHasInsufficientMaterial)
+
+  // One move away, through the lookahead: every legal move leads to a lock.
+  test("locked after stepping out of a pawn's check"):
+    val position = fenToGame(FullFen("8/8/1k6/p2p2p1/PK1P2Pp/7P/8/8 w - - 0 49"), Standard).position
+    assertNot(Lock.cannotBeMated(position, position.color))
+    assert(position.opponentHasInsufficientMaterial)
+  test("locked after the forced capture of a rook"):
+    val position = fenToGame(FullFen("8/8/6R1/1p1p1k2/1P1Pp3/4P1p1/6P1/6K1 b - - 2 42"), Standard).position
+    assertNot(Lock.cannotBeMated(position, position.color))
+    assert(position.opponentHasInsufficientMaterial)
+
+  test("not locked: a knight on the board"):
+    val position = fenToGame(FullFen("8/8/4k3/3p2p1/1p1P1pP1/1P3P2/8/3KN3 b - - 47 92"), Standard).position
+    assertNot(Lock.cannotBeMated(position, position.color))
+    assertNot(position.opponentHasInsufficientMaterial)
+  test("not locked: a pawn can still capture"):
+    val position = fenToGame(FullFen("8/8/4k3/3p2p1/1p1P1pP1/1P2P3/8/3K4 b - - 0 92"), Standard).position
+    assertNot(Lock.cannotBeMated(position, position.color))
