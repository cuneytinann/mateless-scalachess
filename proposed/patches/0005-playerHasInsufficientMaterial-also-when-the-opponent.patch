From 33bf1186f452cab848c933d18e2bc3195cf34626 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?C=C3=BCneyt=20=C4=B0nan?= <cuneytinan37@gmail.com>
Date: Thu, 19 Nov 2026 22:15:31 +0300
Subject: [PATCH 5/5] playerHasInsufficientMaterial: also when the opponent is
 locked out of being mated

---
 core/src/main/scala/Position.scala     |  6 +++---
 test-kit/src/test/scala/LockTest.scala | 10 ++++++++++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/core/src/main/scala/Position.scala b/core/src/main/scala/Position.scala
index cab557a..3403f10 100644
--- a/core/src/main/scala/Position.scala
+++ b/core/src/main/scala/Position.scala
@@ -110,13 +110,13 @@ case class Position(board: Board, history: History, variant: Variant, color: Col
             winner =!= Some(!color) && (
               winner === Some(color) ||
                 newPos.playerHasInsufficientMaterial ||
-                newPos.staleMate ||
-                newPos.lockedFor(color)
+                newPos.staleMate
             )
           }
       )
 
-  inline def playerHasInsufficientMaterial: Boolean = variant.playerHasInsufficientMaterial(this)
+  def playerHasInsufficientMaterial: Boolean =
+    variant.playerHasInsufficientMaterial(this) || lockedFor(!color)
 
   @threadUnsafe
   lazy val threefoldRepetition: Boolean = history.threefoldRepetition
diff --git a/test-kit/src/test/scala/LockTest.scala b/test-kit/src/test/scala/LockTest.scala
index 40b1276..df67421 100644
--- a/test-kit/src/test/scala/LockTest.scala
+++ b/test-kit/src/test/scala/LockTest.scala
@@ -71,3 +71,13 @@ class LockTest extends ChessTest:
   test("flag: not locked"):
     assertNot(at("8/8/4k3/3p2p1/1p1P1pP1/1P3P2/8/3KN3 b - - 47 92").opponentHasInsufficientMaterial)
     assertNot(at("8/8/4k3/3p2p1/1p1P1pP1/1P2P3/8/3K4 b - - 0 92").opponentHasInsufficientMaterial)
+
+  // lila asks the same two functions when a player resigns or offers a draw (RoundGame.cannotLose):
+  // opponentHasInsufficientMaterial on the player's own turn, playerHasInsufficientMaterial otherwise.
+  test("resign: the locked side cannot lose, on either turn"):
+    assert(at("8/1p1k4/4p3/1P1pP1p1/1p1P2Pp/1P1K3P/8/8 w - - 0 47").opponentHasInsufficientMaterial)
+    assert(at("8/1p1k4/4p3/1P1pP1p1/1p1P2Pp/1P1K3P/8/8 b - - 0 47").playerHasInsufficientMaterial)
+
+  test("resign: the side that is not locked can still lose"):
+    assertNot(at("8/1p1k4/4p3/1P1pP1p1/1p1P2Pp/1P1K3P/8/8 w - - 0 47").playerHasInsufficientMaterial)
+    assertNot(at("8/1p1k4/4p3/1P1pP1p1/1p1P2Pp/1P1K3P/8/8 b - - 0 47").opponentHasInsufficientMaterial)
-- 
